# Copie este arquivo para ".env" (uso local) ou cadastre as duas variáveis
# na hospedagem (Netlify/Vercel/Cloudflare Pages). Não coloque aspas.
#
# Supabase > Project Settings > API:
#   - "Project URL"  -> VITE_SUPABASE_URL
#   - chave "anon" / "public" (ou "publishable") -> VITE_SUPABASE_ANON_KEY
#
# Estas duas são PÚBLICAS por desenho: vão para o navegador e a segurança
# vem das políticas RLS do banco (supabase/schema.sql).
# NUNCA coloque aqui a chave "service_role" / "secret".
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=cole-aqui-a-chave-anon-publica
